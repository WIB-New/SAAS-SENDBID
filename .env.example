# ──────────────────────────────────────────────
#  StorageHub — Configuration environnement
# ──────────────────────────────────────────────

# Server
APP_ENV=development                    # production en prod (HMAC exigé, /docs off)
APP_HOST=0.0.0.0
APP_PORT=8080
BASE_URL=http://localhost:8000         # base publique des URLs générées

# Database — SQLite par défaut en dev (commenter cette ligne)
# DATABASE_URL=sqlite+aiosqlite:///./sendbid_storage.db
DATABASE_URL=postgresql+asyncpg://storagehub:storagehub_pass@localhost:5432/storagehub

# Auth — clé maître interne (admin /v1/admin). Les clients ont leurs propres clés en DB.
API_KEY=dev-api-key-change-in-production
HMAC_SECRET=dev-hmac-secret-change-in-production
HMAC_TIMESTAMP_TOLERANCE_SECONDS=30

# Chiffrement au repos des documents sensibles (kyc/receipts, AES-256-GCM par tenant)
ENCRYPTION_KEY=dev-encryption-key-change-in-production

# Stockage — local OU s3 (S3/R2/MinIO via boto3)
UPLOAD_ROOT=./uploads
STORAGE_BACKEND=local
# S3_BUCKET=storagehub
# S3_ENDPOINT_URL=                       # vide = AWS, sinon https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=                    # base CDN publique pour les avatars

# Limites par catégorie (MB)
MAX_SIZE_AVATAR_MB=5
MAX_SIZE_KYC_MB=10
MAX_SIZE_RECEIPT_MB=10
MAX_SIZE_FILE_MB=100

# URLs signées
SIGNED_URL_TTL=60

# CDN — base publique des URLs avatars
CDN_BASE_URL=http://localhost:8000

# Rate limiting distribué (optionnel — sinon compteurs en mémoire)
# REDIS_URL=redis://localhost:6379/0

# Proxy de confiance pour X-Forwarded-For (rate limiting par IP) —
# CSV des IPs de vos reverse-proxies frontaux. Vide = X-Forwarded-For ignoré.
# TRUSTED_PROXY=10.0.0.1,10.0.0.2

# Rétention des journaux d'audit (jours)
AUDIT_RETENTION_DAYS=365

# Upload multipart (gros fichiers / reprise) — parts en Mo, TTL session, plafond
# MULTIPART_PART_SIZE_MB=8
# MULTIPART_MAX_PARTS=1000
# MULTIPART_SESSION_HOURS=24
# MULTIPART_MAX_SIZE_MB=2048

# Monitoring
DISK_ALERT_THRESHOLD_PERCENT=80

# Antivirus externe (optionnel — lookup par hash, aucun upload)
# VIRUSTOTAL_API_KEY=

# Billing Stripe (optionnel — inactif si non configuré)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
