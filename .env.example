# ──────────────────────────────────────────────
#  SAAS SENDBID — Storage Service Environment
# ──────────────────────────────────────────────

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgresql+asyncpg://sendbid:sendbid_pass@localhost:5432/sendbid_storage

# Auth
API_KEY=dev-api-key-change-in-production
HMAC_SECRET=dev-hmac-secret-change-in-production
HMAC_TIMESTAMP_TOLERANCE_SECONDS=30

# Storage
UPLOAD_ROOT=./uploads
MAX_SIZE_AVATAR_MB=5
MAX_SIZE_KYC_MB=10
MAX_SIZE_RECEIPT_MB=10

# Signed URL TTL (seconds)
SIGNED_URL_TTL=60

# CDN
CDN_BASE_URL=https://cdn.sendbid.com

# Monitoring
DISK_ALERT_THRESHOLD_PERCENT=80
